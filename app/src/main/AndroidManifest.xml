<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Gemini and the user-configured HTTPS LibreTranslate endpoint. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Overlay: floating button + debug capture view -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Capture pipeline (M2): MediaProjection + foreground service of type mediaProjection -->
    <uses-permission android:name="android.permission.MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Optional: foreground-app check for live mode allow-list (UsageStatsManager). Grant via system Settings. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- API 34+: required when calling startForeground(..., FOREGROUND_SERVICE_TYPE_SPECIAL_USE) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ManhwaLensApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.ManhwaLens"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ManhwaLens">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.ManhwaLens" />

        <service
            android:name=".capture.ManhwaAutoCaptureService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <activity
            android:name=".capture.CaptureConsentActivity"
            android:exported="false"
            android:theme="@style/Theme.ManhwaLens.Transparent"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:taskAffinity="" />

        <service
            android:name=".overlay.FloatingButtonService"
            android:exported="false"
            android:foregroundServiceType="specialUse|mediaProjection">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="manhwalens_capture_overlay" />
        </service>
    </application>

</manifest>
