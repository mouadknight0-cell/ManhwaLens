<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ManhwaLens" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Translucent trampoline for the MediaProjection consent dialog; draws nothing. -->
    <style name="Theme.ManhwaLens.Transparent" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
